# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/etlninja

# JWT Secret
JWT_SECRET=your_super_secret_key_change_this_in_production

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# Anthropic API key for /api/hints (Section 7).
# Without this set, /api/hints falls back to a deterministic local hint so
# the route still works in development. Section 9 will add the rest of the
# environment variables (SMTP, INVITE_BASE_URL, MAX_CONCURRENT_EXECUTIONS).
ANTHROPIC_API_KEY=

# Claude model used by the hints service. Override to pin to a specific
# version. Defaults to claude-sonnet-4-5 in services/hintsService.js.
ANTHROPIC_MODEL=

# ---- Section 9: Email + invitations + concurrency guard ----
# SMTP host for the candidate-invite email (Section 8 + 9B). If unset, the
# email service logs a warning and skips the send (the invite modal still
# generates copy-pasteable URLs).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourplatform.com

# Base URL for invite links. The frontend prepends this to
# `/assessments/join/:token` when displaying the link in the invite modal
# (falls back to window.location.origin when unset).
INVITE_BASE_URL=http://localhost:3000

# Mount path of the Docker socket the executor uses. Override only if your
# Docker daemon listens somewhere non-standard (e.g. Colima, rootless).
DOCKER_SOCKET=/var/run/docker.sock

# Max concurrent Docker runs the executor will hold. Consumed by the
# Section 10 async-semaphore. Default 10 is a safe starting point for a
# single-node dev box; raise for production with care (each spawn uses
# ~256MB–1GB depending on executor).
MAX_CONCURRENT_EXECUTIONS=10
