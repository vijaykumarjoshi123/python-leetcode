# Production environment template.
#
# This file is NOT loaded by the dev compose. Production reads from
# /etc/platform/backend.env (see docker-compose.prod.yml).
#
# Copy this to the production host:
#   scp backend/.env.prod.example prod-host:/etc/platform/backend.env
# Then edit secrets in place. NEVER commit the filled-in file.
#
# Secret rotation reminder: rotate JWT_SECRET and SMTP_PASS every 90
# days, or immediately on suspected compromise.

# ---- Core ----
NODE_ENV=production
PORT=5000

# MongoDB. The /etc/platform network DNS-resolves the service name
# 'mongodb' to the mongo container.
MONGODB_URI=mongodb://mongodb:27017/etlninja

# Redis (rate limiting, BullMQ).
REDIS_URL=redis://redis:6379

# JWT — GENERATE a strong random value. Do NOT reuse the dev default.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# ---- Hints API (Section 7) ----
# Without this, the hints endpoint serves a deterministic fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Email (Section 9) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourplatform.com

# Public base URL the candidate sees in their invite emails. Must be
# the URL real users hit (not the internal docker DNS).
INVITE_BASE_URL=https://your-platform.example.com

# ---- Concurrency guard (Section 10) ----
DOCKER_SOCKET=/var/run/docker.sock

# Tune based on host capacity. Each in-flight execution uses
# 256MB–1GB depending on executor. A 16GB host with 4 vCPUs is roughly
# comfortable at 10; a 32GB host with 8 vCPUs can run 20.
MAX_CONCURRENT_EXECUTIONS=10

# ---- CORS ----
# Comma-separated list of allowed origins for the API. The frontend at
# the same host won't need this; only set if you split frontend and
# backend onto different domains.
CORS_ORIGINS=https://your-platform.example.com
